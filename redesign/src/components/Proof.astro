---
/**
 * The picture beside the page introductions. Shows your photo if
 * src/assets/photo.(jpg|png|webp) exists, otherwise three real certificates.
 */
import { Image, getImage } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import { certificates } from '../data/certificates';

const found = import.meta.glob<{ default: ImageMetadata }>('../assets/photo.{jpg,jpeg,png,webp}', { eager: true });
const source = Object.values(found)[0]?.default;
const photo = source && (await getImage({ src: source, width: 720, height: 840, format: 'webp' }));

const stack = [
  { cert: certificates.sih, caption: 'Smart India Hackathon 2025', place: 'ml-auto w-[78%] rotate-3', speed: -0.22 },
  { cert: certificates.ciphathon, caption: 'MITWPU Ciphathon ’26', place: '-mt-[22%] w-[78%] -rotate-3', speed: -0.1 },
  { cert: certificates.codeForBharat, caption: 'Winner, Code for Bharat', place: '-mt-[18%] ml-[14%] w-[84%] rotate-1', speed: 0.05 },
];
---

{photo ? (
  <img src={photo.src} width="720" height="840" alt="Portrait of Divesh Adivarekar" class="mx-auto w-full max-w-sm rounded-3xl border border-line shadow-2xl" />
) : (
  <ul class="mx-auto w-full max-w-lg" aria-label="Hackathon certificates">
    {stack.map(({ cert, caption, place, speed }, i) => (
      <li class:list={['relative', place]} data-speed={speed} data-from-top>
        <a href={cert.href} class="group block overflow-hidden rounded-2xl border border-line bg-surface p-2 shadow-2xl transition-transform hover:z-10 hover:-translate-y-1">
          <Image src={cert.image} alt={`Certificate: ${cert.title}`} widths={[420, 840]} sizes="(min-width: 1024px) 420px, 80vw" format="webp" loading={i === 2 ? 'eager' : 'lazy'} class="aspect-[7/5] w-full rounded-xl object-cover" />
          <span class="block px-1 pt-2 pb-0.5 text-xs font-semibold group-hover:text-accent">{caption}</span>
        </a>
      </li>
    ))}
  </ul>
)}
