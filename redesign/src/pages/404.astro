---
import Base from '../layouts/Base.astro';
---

<Base title="Page not found | Divesh Adivarekar" description="This page doesn’t exist. Go to the home page or see Divesh Adivarekar’s projects.">
  <div class="hero-bg">
    <div class="wrap py-24 text-center sm:py-32">
      <p class="gradient-text font-display text-7xl font-bold">404</p>
      <h1 class="mt-4 text-3xl font-bold">This page doesn’t exist</h1>
      <p class="mt-3 text-muted">The address may have changed.</p>
      <div class="mt-8 flex flex-wrap justify-center gap-3">
        <a class="btn btn-primary" href="/">Go to the home page</a>
        <a class="btn btn-ghost" href="/work.html">See projects</a>
      </div>
    </div>
  </div>
</Base>
