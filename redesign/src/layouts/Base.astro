---
import '@fontsource-variable/bricolage-grotesque';
import '@fontsource-variable/inter';
import '../styles/global.css';
import { resume, social } from '../data/profile';

interface Props {
  title: string;
  description: string;
}

const { title, description } = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site).href;
const shareImage = new URL('/og-image.png', Astro.site).href;
const year = new Date().getFullYear();
// Structured data that helps search engines identify the person behind the site.
const person = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  name: 'Divesh Adivarekar',
  url: Astro.site?.href,
  jobTitle: 'AI and software development intern',
  address: { '@type': 'PostalAddress', addressLocality: 'Pune', addressCountry: 'IN' },
  sameAs: social.map((s) => s.href),
};

const nav = [
  { href: '/work.html', label: 'Projects' },
  { href: '/achievements.html', label: 'Achievements' },
  { href: '/about.html', label: 'About' },
  { href: '/contact.html', label: 'Contact' },
];
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={shareImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />
    <script type="application/ld+json" is:inline set:html={JSON.stringify(person)} />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <script is:inline>
      // Runs before paint so the saved theme never flashes.
      (() => {
        let saved = null;
        try { saved = localStorage.getItem('theme'); } catch {}
        const dark = saved ? saved === 'dark' : matchMedia('(prefers-color-scheme: dark)').matches;
        document.documentElement.dataset.theme = dark ? 'dark' : 'light';
      })();
    </script>
  </head>
  <body>
    <a href="#main" class="sr-only focus:not-sr-only focus:absolute focus:left-4 focus:top-4 focus:z-50 focus:rounded-lg focus:bg-surface focus:px-4 focus:py-2">
      Skip to content
    </a>

    <header class="sticky top-0 z-40 border-b border-line bg-bg/90 backdrop-blur">
      <div class="wrap flex flex-wrap items-center justify-between gap-x-6 py-3">
        <a href="/" class="font-display text-lg font-semibold">Divesh Adivarekar</a>
        <button id="theme-toggle" type="button" class="btn btn-ghost order-2 px-3 sm:order-3">Theme</button>
        <nav aria-label="Main" class="order-3 w-full sm:order-2 sm:ml-auto sm:w-auto">
          <ul class="flex justify-between gap-5 pt-3 text-sm font-medium text-muted sm:pt-0">
            {nav.map((item) => (
              <li>
                <a
                  class="hover:text-accent aria-[current=page]:text-accent"
                  href={item.href}
                  aria-current={Astro.url.pathname.replace(/\.html$/, '') === item.href.replace(/\.html$/, '') ? 'page' : undefined}
                >
                  {item.label}
                </a>
              </li>
            ))}
          </ul>
        </nav>
      </div>
    </header>

    <main id="main">
      <slot />
    </main>

    <footer class="border-t border-line py-10">
      <div class="wrap flex flex-col gap-4 text-sm text-muted sm:flex-row sm:items-center sm:justify-between">
        <p>© {year} Divesh Adivarekar</p>
        <ul class="flex flex-wrap gap-x-6 gap-y-2">
          <li><a class="hover:text-accent" href={resume}>Résumé</a></li>
          <li><a class="hover:text-accent" href="/writeups.html">Student resources</a></li>
          {social.map((item) => (
            <li><a class="hover:text-accent" href={item.href}>{item.label}</a></li>
          ))}
        </ul>
      </div>
    </footer>

    <script>
      import '../scripts/motion';
    </script>

    <script>
      const root = document.documentElement;
      const button = document.getElementById('theme-toggle')!;
      const label = () => {
        button.textContent = root.dataset.theme === 'dark' ? 'Light' : 'Dark';
        button.setAttribute('aria-label', `Switch to ${button.textContent.toLowerCase()} theme`);
      };
      label();
      button.addEventListener('click', () => {
        root.dataset.theme = root.dataset.theme === 'dark' ? 'light' : 'dark';
        try { localStorage.setItem('theme', root.dataset.theme); } catch {}
        label();
      });
    </script>
  </body>
</html>
